{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-GB",
  "dictionaries": ["softwareTerms", "typescript", "node", "npm", "html", "css", "sql", "docker"],
  "ignorePaths": [
    "node_modules",
    "**/node_modules/**",
    "package-lock.json",
    "dist",
    "coverage",
    "docs/design/source/**",
    "docs/glossary.md",
    "db/tests/tsqlt/install/*.sql",
    "db/tests/tsqlt/install/*.txt",
    "db/tests/tsqlt/install/SHA256SUMS",
    "README.md",
    "tools/scripts/lib/spelling-rules.ts",
    "tools/scripts/arch-fixtures/**",
    "LICENSE",
    "*.pdf",
    ".git"
  ],
  "overrides": [
    {
      "filename": "**/*.md",
      "ignoreRegExpList": [
        "/\\/\\*[\\s\\S]*?\\*\\//g",
        "/^\\s*(--|\\/\\/).*$/gm",
        "/\\s--\\s.*$/gm",
        "/\\s\\/\\/\\s.*$/gm"
      ]
    },
    {
      "filename": "**/*.{ts,tsx,js,mjs,cjs,css}",
      "ignoreRegExpList": ["/\\/\\*[\\s\\S]*?\\*\\//g", "/(^|[^:\"'`])\\/\\/.*$/gm"]
    },
    {
      "filename": "**/*.sql",
      "ignoreRegExpList": ["/\\/\\*[\\s\\S]*?\\*\\//g", "/--.*$/gm"]
    },
    {
      "filename": "**/{*.{yml,yaml,sh,conf,properties},Dockerfile*,.env.example,.gitignore,.gitattributes,.dockerignore,.editorconfig}",
      "ignoreRegExpList": ["/(^|\\s)#.*$/gm"]
    },
    {
      "filename": "**/*.json",
      "ignoreRegExpList": ["/\"(integrity|resolved)\":\\s*\"[^\"]*\"/g"]
    }
  ],
  "ignoreRegExpList": [
    "/\\b[0-9a-f]{7,40}\\b/gi",
    "/\\bhttps?:\\/\\/\\S+/g",
    "/^.*<!--\\s*spelling-ignore\\s*-->.*$/gm"
  ],
  "words": [
