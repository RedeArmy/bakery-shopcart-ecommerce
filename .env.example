# ShopCart · variables de entorno de ejemplo.
# Copie este archivo a .env (npm run up lo hace por usted y genera los secretos locales).
# Nunca escriba valores reales en este archivo: está versionado.

# --- Base de datos -------------------------------------------------------
# Contraseña del usuario sa del contenedor (mínimo 8 caracteres con mayúsculas, minúsculas y dígitos)
MSSQL_SA_PASSWORD=
# Memoria máxima de SQL Server en MB; ajústela en equipos con poca RAM
MSSQL_MEMORY_LIMIT_MB=2048
DB_HOST=db
DB_PORT=1433
DB_NAME=ShopCart
# Vacío: se confía en el certificado autofirmado salvo en producción. Con un servidor real use false
DB_TRUST_SERVER_CERTIFICATE=
# Usuario de la aplicación: solo EXECUTE sobre procedimientos almacenados
DB_APP_USER=shopcart_app
DB_APP_PASSWORD=

# --- Backend ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Secreto para firmar los access tokens JWT
JWT_ACCESS_SECRET=
# Pepper para el hash SHA-256 de los refresh tokens
JWT_REFRESH_PEPPER=
ACCESS_TTL=15m
REFRESH_TTL=7d
# Lista blanca de orígenes CORS separada por comas
CORS_ORIGINS=http://localhost:8080
# URL pública de la tienda (success_url y cancel_url de la pasarela)
APP_PUBLIC_URL=http://localhost:8080

# --- Comprobantes de pago (depósito bancario) -------------------------------------------
PAYMENT_PROOFS_DIR=/data/payment-proofs
PAYMENT_PROOF_MAX_BYTES=5242880

# --- Pagos con tarjeta (Recurrente) ----------------------------------------
# Si PUBLIC_KEY o SECRET_KEY quedan vacías, solo se ofrece depósito bancario
RECURRENTE_PUBLIC_KEY=
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=
RECURRENTE_BASE_URL=https://app.recurrente.com/api
PAYMENTS_CARD_ENABLED=true

# --- Puertos publicados en el equipo ---------------------------------------
EDGE_PORT=8080
