{
  "name": "shopcart",
  "version": "0.1.0",
  "private": true,
  "description": "ShopCart: e-commerce platform for the Dulce Aroma bakery (Tech Challenge 360)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "backend",
    "frontend",
    "db/runner",
    "tools/*"
  ],
  "scripts": {
    "prepare": "husky",
    "up": "tsx tools/scripts/ensure-env.ts && docker compose up -d --build --wait",
    "down": "docker compose down",
    "logs": "docker compose logs -f --tail=100",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test --workspaces --if-present",
    "test:integration": "tsx tools/scripts/not-implemented.ts --pass test:integration 2",
    "lint": "npm run lint:code && npm run format:check && npm run spell && npm run lint:spelling && npm run lint:readme && npm run sql:lint",
    "lint:code": "eslint .",
    "lint:spelling": "tsx tools/scripts/check-british-spelling.ts",
    "lint:readme": "tsx tools/scripts/check-readme-sync.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spell": "cspell --no-progress --no-summary \"**/*\"",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p db/lint",
    "arch:check": "depcruise --config .dependency-cruiser.cjs backend/src && tsx tools/scripts/arch-self-test.ts",
    "db:migrate": "tsx tools/scripts/not-implemented.ts db:migrate 2",
    "db:verify": "tsx tools/scripts/not-implemented.ts db:verify 2",
    "sql:lint": "tsx db/lint/lint-file-names.ts",
    "sql:test": "tsx tools/scripts/not-implemented.ts sql:test 2",
    "sql:coverage": "tsx tools/scripts/not-implemented.ts sql:coverage 2",
    "seed": "tsx tools/scripts/not-implemented.ts seed 2",
    "api:generate": "tsx tools/scripts/not-implemented.ts api:generate 7",
    "sonar": "tsx tools/scripts/not-implemented.ts sonar 9",
    "test:coverage": "npm run test:coverage --workspaces --if-present"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css,html}": "prettier --write",
    "*.{ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "cspell": "^9.0.0",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vitest": "^3.2.0"
  }
}
